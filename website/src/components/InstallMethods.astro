---
import { TabItem, Tabs } from "@astrojs/starlight/components";
import { INSTALL_METHODS } from "../data/install.js";
import { INSTALLATION_RELEASE_TAG } from "../data/publication.js";
import { RELEASE_TAG, RELEASE_URL } from "../data/project.js";
import InstallMethod from "./InstallMethod.astro";
---

<div class="install-methods" data-install-methods>
  {INSTALLATION_RELEASE_TAG !== RELEASE_TAG && (
    <p>Installation preview for {INSTALLATION_RELEASE_TAG}. Its downloads and image become available after publication. The current published release is <a href={RELEASE_URL}>{RELEASE_TAG}</a>.</p>
  )}
  <Tabs syncKey="install-method">
    {
      INSTALL_METHODS.map((method) => (
        <TabItem label={method.label}>
          <InstallMethod method={method} />
        </TabItem>
      ))
    }
  </Tabs>
  <noscript>
    <style>
      [data-install-methods] starlight-tabs {
        display: none !important;
      }
    </style>
    {INSTALL_METHODS.map((method) => <InstallMethod method={method} heading />)}
  </noscript>
</div>

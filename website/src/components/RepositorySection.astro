---
import { getEntry, render } from "astro:content";
import { repositoryFileUrl } from "../data/repository.js";
import { headingSlug } from "../loaders/repository-markdown.js";

interface Props {
  id: string;
}

const entry = await getEntry("repositorySections", Astro.props.id);
if (!entry) throw new Error(`Unknown repository section: ${Astro.props.id}`);
const { Content } = await render(entry);
const sourceUrl = repositoryFileUrl(`${entry.data.file}#${headingSlug(entry.data.heading)}`);
---

<div class="repository-section" data-repository-section={Astro.props.id}>
  <Content />
  <p class="repository-section-source">
    Rendered from <a href={sourceUrl} rel="external">{entry.data.file} § {entry.data.heading}</a> in the
    repository.
  </p>
</div>

---
import { Code } from "@astrojs/starlight/components";
import { RELEASE_IMAGE, type InstallMethod } from "../data/install.js";

interface Props {
  method: InstallMethod;
  heading?: boolean;
}

const { method, heading = false } = Astro.props;
---

<section class="install-method" data-install-method={method.key} aria-label={method.label}>
  {heading && <h3>{method.label}</h3>}
  <p>{method.summary}</p>
  {method.key === "docker" && <Code lang="sh" title="Pull the beta image" code={`docker pull ${RELEASE_IMAGE}`} />}
  <ul>
    {method.links.map(({ label, href }) => <li><a href={href} rel="external">{label}</a></li>)}
  </ul>
  <a href={method.guide}>{method.guideLabel} →</a>
</section>

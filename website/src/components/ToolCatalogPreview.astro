---
import { Icon } from "@astrojs/starlight/components";
import catalog from "../../../docs/tool-catalog.json";

// Prefer short names when choosing examples so each row stays readable on a phone.
const names = Object.keys(catalog.tools).sort(
  (a, b) => a.length - b.length || a.localeCompare(b, "en"),
);
const groups = [
  { label: "Stacks", query: "stack" },
  { label: "Deployments", query: "deployment" },
  { label: "Servers", query: "server" },
  { label: "Builds and Builders", query: "build" },
  { label: "ResourceSyncs", query: "resource_sync" },
].map((group) => ({ ...group, tools: names.filter((name) => name.includes(group.query)) }));
---

<figure
  class="catalog-preview not-content"
  data-catalog-preview
  data-tool-count={names.length}
  data-preview-category-count={groups.length}
>
  <div class="catalog-preview__bar" aria-hidden="true">
    <span></span><span></span><span></span>
    <strong>MCP request</strong>
  </div>
  <div class="catalog-preview__body">
    <p>MCP method: <code>tools/list</code></p>
    <p class="catalog-preview__success">
      <Icon name="puzzle" size="1.1rem" />
      <span>{names.length} tools loaded from the project catalog</span>
    </p>
    <dl>
      {groups.map(({ label, query, tools }) => (
        <div data-catalog-preview-row data-category={query}>
          <dt><a href={`/reference/tools/?q=${query}#built-in-tools`}>{label}</a></dt>
          <dd>
            <strong>{tools.length}</strong>{" "}
            {tools.slice(0, 4).join(", ")}{tools.length > 4 && ", …"}
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <figcaption>
    This preview uses the server’s static tool catalog. Your local grants and tool selection
    determine which tools your client discovers.
  </figcaption>
</figure>

<style>
  .catalog-preview {
    margin-block: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
  }

  .catalog-preview__bar,
  figcaption {
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
  }

  .catalog-preview__bar {
    display: flex;
    min-height: 42px;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .catalog-preview__bar > span {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 50%;
  }

  .catalog-preview__bar strong {
    margin-inline-start: 0.35rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .catalog-preview__body {
    padding: clamp(0.9rem, 2vw, 1.25rem);
    font-family: var(--sl-font-mono);
    font-size: clamp(0.75rem, 1.8vw, 0.88rem);
  }

  .catalog-preview__body > p {
    margin: 0 0 0.65rem;
  }

  .catalog-preview__body code {
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    font: inherit;
  }

  .catalog-preview__success {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-text-accent);
  }

  dl {
    margin: 1rem 0 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.65rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  dt a {
    color: var(--sl-color-text-accent);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--sl-color-gray-2);
  }

  dd strong {
    display: inline-grid;
    min-width: 1.75rem;
    min-height: 1.75rem;
    place-items: center;
    margin-inline-end: 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    color: var(--sl-color-white);
  }

  figcaption {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.78rem;
  }

  @media (max-width: 42rem) {
    dl > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

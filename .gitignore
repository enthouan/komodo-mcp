# Rust build output and formatter backups
target/
**/*.rs.bk

# Local environment files
.env
.env.*
!.env.example
!.env.*.example

# macOS metadata
.DS_Store

# Benchmark Python bytecode
__pycache__/

# Keep raw benchmark runs local. Only the findings summary belongs in Git.
/benchmarks/**/*.json
/benchmarks/**/*.json.gz
/benchmarks/results/*
!/benchmarks/results/README.md

# Website (Node is a website build dependency only)
node_modules/
website/dist/
website/.astro/
website/test-results/
website/playwright-report/
website/artifacts/

# Synthetic placeholders. Export these in the MCP process environment.
KOMODO_ADDRESS=https://komodo.example.test
KOMODO_API_KEY=replace-with-your-api-key
KOMODO_API_SECRET=replace-with-your-api-secret
# Default transport. To serve authenticated HTTP, set this to http and supply tokens.
KOMODO_TRANSPORT=stdio
# KOMODO_HTTP_BIND=127.0.0.1:3000
# Supply a distinct, securely generated bearer token for each client.
# KOMODO_HTTP_TOKENS=
# Native HTTP clients can omit Origin. List exact browser origins only if needed.
# KOMODO_HTTP_ALLOWED_ORIGINS=https://client.example.test
# Optional independent local grants. Unset also means false; only true/false are valid.
KOMODO_ALLOW_OPERATE=false
KOMODO_ALLOW_CONFIGURATION_EDIT=false
# Category-wide pruning also requires operate and Core Execute on one Server.
KOMODO_ALLOW_PRUNE=false
# Fresh one-command terminals also require operate and Core Read + Terminal.
KOMODO_ALLOW_TERMINAL=false
